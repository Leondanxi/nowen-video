# syntax=docker/dockerfile:1.6
# Nowen Video —— ffmpeg-over-ip 远端 GPU 转码镜像
#
# 镜像内容：nowen 本体 + ffmpeg-over-ip 客户端（静态 Go 二进制，以
#   /usr/local/bin/ffmpeg 与 /usr/local/bin/ffprobe 两个软链形式存在）。
# 容器内**没有** ffmpeg、也没有 GPU；所有 ffmpeg/ffprobe 调用都由客户端
# 通过 TCP 转发到「带 GPU 的 ffmpeg-over-ip 服务端」（如你直通了
# RTX 2070 Super 的 Windows VM），文件 I/O 经连接回传，服务端不落盘。
#
# 运行时必须配置（compose 已设好）：
#   FFMPEG_OVER_IP_CLIENT_ADDRESS= <GPU主机IP>:5050
#   FFMPEG_OVER_IP_CLIENT_AUTH_SECRET= <与服务端一致的密钥>
#   NOWEN_TRANSCODE_HW_DECODE_MODE=hardware
#   NOWEN_TRANSCODE_HW_ENCODER=nvenc
#
# 服务端部署见 deploy/ffmpeg-over-ip-server/ 目录。

# ---------- 1) 拉取 ffmpeg-over-ip 静态客户端 ----------
FROM alpine:3.24 AS foip-client
ARG TARGETARCH
RUN apk add --no-cache curl unzip ca-certificates
RUN arch="$TARGETARCH"; \
    case "$arch" in amd64) fa=amd64 ;; arm64) fa=arm64 ;; *) echo "unsupported arch: $arch" >&2; exit 1 ;; esac; \
    curl -fsSL -o /tmp/client.zip \
      "https://github.com/steelbrain/ffmpeg-over-ip/releases/latest/download/linux-${fa}-ffmpeg-over-ip-client.zip"; \
    unzip -o -q /tmp/client.zip -d /tmp/client; \
    bin="$(find /tmp/client -type f -name ffmpeg-over-ip-client | head -1)"; \
    test -n "$bin" && install -m 0755 "$bin" /usr/local/bin/ffmpeg-over-ip-client

# ---------- 2) 前端 ----------
FROM --platform=$BUILDPLATFORM node:22-alpine AS frontend
ARG NOWEN_VERSION=0.4.0
WORKDIR /app/web
COPY web/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/ .
ENV VITE_APP_VERSION=${NOWEN_VERSION}
RUN npx vite build

# ---------- 3) 后端 ----------
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS backend
ARG TARGETOS
ARG TARGETARCH
ARG NOWEN_VERSION=0.4.0
WORKDIR /app
ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
COPY --from=frontend /app/web/dist ./web/dist
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
      -ldflags="-s -w -X github.com/nowen-video/nowen-video/internal/version.Version=${NOWEN_VERSION}" \
      -o nowen-video ./cmd/server-lite

# ---------- 4) 运行时：本体 + ffmpeg-over-ip 客户端（无 ffmpeg/无 GPU） ----------
FROM alpine:3.24
ARG NOWEN_VERSION=0.4.0

RUN apk add --no-cache tzdata ca-certificates su-exec
RUN addgroup -S nowen && adduser -S nowen -G nowen

WORKDIR /app
COPY --from=backend /app/nowen-video /usr/local/bin/nowen-video
COPY --from=frontend /app/web/dist /app/web/dist
COPY scripts/docker-entrypoint.sh /entrypoint.sh

# ffmpeg-over-ip 客户端是静态二进制；ffmpeg / ffprobe 两个软链都指向它，
# 客户端按 argv[0] 名字自行区分 ffmpeg 与 ffprobe 模式。
COPY --from=foip-client /usr/local/bin/ffmpeg-over-ip-client /usr/local/bin/ffmpeg-over-ip-client
RUN ln -sf /usr/local/bin/ffmpeg-over-ip-client /usr/local/bin/ffmpeg && \
    ln -sf /usr/local/bin/ffmpeg-over-ip-client /usr/local/bin/ffprobe

RUN mkdir -p /data /cache /media && \
    chown -R nowen:nowen /data /cache /media && \
    chmod +x /entrypoint.sh

ENV NOWEN_APP_PORT=8080
ENV NOWEN_APP_DATA_DIR=/data
ENV NOWEN_APP_WEB_DIR=/app/web/dist
ENV NOWEN_DATABASE_DB_PATH=/data/nowen.db
ENV NOWEN_CACHE_CACHE_DIR=/cache
ENV NOWEN_LOGGING_LEVEL=info
ENV NOWEN_VERSION=${NOWEN_VERSION}
ENV TZ=Asia/Shanghai

# nowen 的 ffmpeg/ffprobe 指向 ffmpeg-over-ip 客户端软链
ENV NOWEN_APP_FFMPEG_PATH=/usr/local/bin/ffmpeg
ENV NOWEN_APP_FFPROBE_PATH=/usr/local/bin/ffprobe

# —— ffmpeg-over-ip 客户端连接参数（运行时由 compose / -e 覆盖）——
# 服务端地址（GPU 主机）：必须填；   密钥：必须与服务端一致。
ENV FFMPEG_OVER_IP_CLIENT_ADDRESS=192.168.1.100:5050
ENV FFMPEG_OVER_IP_CLIENT_AUTH_SECRET=change-me
# 服务端连不上时是否回退本机 ffmpeg：容器内没有 ffmpeg，保持 false，
# 让问题显式暴露，而不是静默退化。
ENV FFMPEG_OVER_IP_CLIENT_FALLBACK_TO_LOCAL=false

# —— 强制硬件管线：容器无 GPU 也不回退 CPU，实际编解码在远端 GPU 完成 ——
ENV NOWEN_TRANSCODE_HW_DECODE_MODE=hardware
ENV NOWEN_TRANSCODE_HW_ENCODER=nvenc

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD /bin/busybox wget -q -O /dev/null http://localhost:8080/api/health || exit 1

CMD ["/entrypoint.sh"]
