# syntax=docker/dockerfile:1.6
# Full compatibility image: legacy server entrypoint plus Python adult scraper.

FROM --platform=$BUILDPLATFORM node:20-alpine AS frontend
ARG NOWEN_VERSION=0.1.0
WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci
COPY web/ .
ENV VITE_APP_VERSION=${NOWEN_VERSION}
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS backend
ARG TARGETOS
ARG TARGETARCH
ARG NOWEN_VERSION=0.1.0
WORKDIR /app
ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /app/web/dist ./web/dist
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
      -ldflags="-s -w -X github.com/nowen-video/nowen-video/internal/version.Version=${NOWEN_VERSION}" \
      -o nowen-video ./cmd/server

FROM alpine:3.24
ARG TARGETARCH
ARG NOWEN_VERSION=0.1.0
ARG FFMPEG_VERSION=8.1.2-r0
# ---------------------------------------------------------------------------
# OPTIONAL ffmpeg-over-ip client bundle (DISABLED BY DEFAULT).
#   FFOIP_VERSION pins a GitHub release tag, e.g. v5.2.1. Leave EMPTY ("") to
#   skip (default). Prefer read-only bind-mount — see
#   docs/ffmpeg-over-ip-deploy.md. When set, fetches
#     https://github.com/steelbrain/ffmpeg-over-ip/releases/download/<TAG>/linux-<TARGETARCH>-ffmpeg-over-ip-client.zip
#   and installs it at /opt/ffoip/ffmpeg with an argv[0] ffprobe symlink.
#   System ffmpeg below is kept intact as a local fallback. No secrets baked in.
# ---------------------------------------------------------------------------
ARG FFOIP_VERSION=""

RUN apk add --no-cache \
      "ffmpeg=${FFMPEG_VERSION}" \
      tzdata \
      ca-certificates \
      su-exec \
      coreutils \
      wget \
      python3 \
      py3-pip \
      py3-flask \
      py3-requests \
      py3-beautifulsoup4 \
      py3-lxml \
    && rm -rf /var/cache/apk/* \
    && ln -sf /bin/nice /usr/bin/nice \
    && ffmpeg -version | head -n 1 | grep -F "ffmpeg version 8.1.2" \
    && ffprobe -version | head -n 1 | grep -F "ffprobe version 8.1.2"

RUN set -eux; \
    if [ "${TARGETARCH}" = "amd64" ]; then \
      apk add --no-cache intel-media-driver libva-intel-driver mesa-va-gallium libva-utils; \
    else \
      apk add --no-cache mesa-va-gallium libva-utils; \
    fi; \
    rm -rf /var/cache/apk/*

# Optional ffmpeg-over-ip client bundle; no-op unless --build-arg FFOIP_VERSION=<tag>.
# Keeps the system ffmpeg above as a local fallback. See docs/ffmpeg-over-ip-deploy.md.
RUN set -eux; \
    if [ -n "${FFOIP_VERSION}" ]; then \
      apk add --no-cache curl unzip; \
      mkdir -p /opt/ffoip; \
      echo "Bundling ffmpeg-over-ip client ${FFOIP_VERSION} for linux-${TARGETARCH}"; \
      curl -fsSL -o /tmp/ffoip.zip \
        "https://github.com/steelbrain/ffmpeg-over-ip/releases/download/${FFOIP_VERSION}/linux-${TARGETARCH}-ffmpeg-over-ip-client.zip"; \
      tmp="$(mktemp -d)"; \
      unzip -o -q /tmp/ffoip.zip -d "${tmp}"; \
      bin="$(find "${tmp}" -type f \( -name 'ffmpeg-over-ip-client*' -o -name 'ffmpeg-over-ip' \) | head -n1)"; \
      [ -n "${bin}" ] || { echo "ffmpeg-over-ip client binary not found in release zip" >&2; exit 1; }; \
      install -m 0755 "${bin}" /opt/ffoip/ffmpeg; \
      ln -sf ffmpeg /opt/ffoip/ffprobe; \
      chmod -R a+rX /opt/ffoip; \
      rm -rf /tmp/ffoip.zip "${tmp}"; \
      ls -l /opt/ffoip; \
    else \
      echo "FFOIP_VERSION not set -> skipping ffmpeg-over-ip client bundle (system ffmpeg remains the only ffmpeg)."; \
    fi

RUN addgroup -S nowen && adduser -S nowen -G nowen
WORKDIR /app
COPY --from=backend /app/nowen-video /usr/local/bin/nowen-video
COPY --from=frontend /app/web/dist /app/web/dist
COPY scripts/adult-scraper /app/scripts/adult-scraper
COPY scripts/docker-entrypoint.sh /entrypoint.sh

RUN mkdir -p /data /cache /media \
    && chown -R nowen:nowen /data /cache /media /app/scripts \
    && chmod +x /entrypoint.sh

ENV NOWEN_APP_PORT=8080
ENV NOWEN_APP_DATA_DIR=/data
ENV NOWEN_APP_WEB_DIR=/app/web/dist
ENV NOWEN_DATABASE_DB_PATH=/data/nowen.db
ENV NOWEN_CACHE_CACHE_DIR=/cache
ENV NOWEN_LOGGING_LEVEL=info
ENV NOWEN_VERSION=${NOWEN_VERSION}
ENV NOWEN_ADULT_SCRAPER_ENABLED=false
ENV NOWEN_ADULT_SCRAPER_AUTO_START_PYTHON=true
ENV NOWEN_ADULT_SCRAPER_PYTHON_EXECUTABLE=/usr/bin/python3
ENV NOWEN_ADULT_SCRAPER_PYTHON_SERVICE_DIR=/app/scripts/adult-scraper
ENV TZ=Asia/Shanghai

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost:8080/api/health || exit 1

CMD ["/entrypoint.sh"]
